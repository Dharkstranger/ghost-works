{
  "enabled": true,
  "name": "Tests on save",
  "description": "When a rule file changes, run the tests and fix what fails before going on.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/book.ts", "src/ghost.ts", "src/share.ts", "src/export.ts"] },
  "then": { "type": "askAgent", "prompt": "Run npm test. If anything fails, find why from the failing case and fix the rule, not the test. Report in one line." }
}
